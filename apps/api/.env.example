# HERE Maps Routing API — free tier, 250k req/month
# Register: https://developer.here.com
HERE_API_KEY=

# Optional fallback traffic provider
TOMTOM_API_KEY=

# Vercel KV (Redis) — only needed once we add the serverless poller in Phase 08
VERCEL_KV_REST_API_URL=
VERCEL_KV_REST_API_TOKEN=

# Expo push service — needed by the cron poller that sends "leave now" notifications
EXPO_ACCESS_TOKEN=

# Vercel Cron bearer token. Vercel auto-injects this header on scheduled invocations
# when CRON_SECRET is set as an env var. Used by /api/cron/* to reject unauthenticated hits.
CRON_SECRET=
