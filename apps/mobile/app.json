{
  "expo": {
    "name": "BusBuddy",
    "slug": "bus-tracker",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "t816",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.willywong.bustracker",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.willywong.bustracker"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-task-manager",
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BusBuddy shows where you are on the map and counts down the stops while you ride.",
          "locationAlwaysAndWhenInUsePermission": "If you turn on “Notify me at my stop”, BusBuddy notices when you arrive at your saved bus stops and tells you when the next bus is due."
        }
      ],
      "expo-web-browser",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.willywong.bustracker.widgets",
          "groupIdentifier": "group.com.willywong.bustracker",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "NextBusWidget",
              "displayName": "Next bus",
              "description": "Countdown to the next bus at your stop.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./widgets/NextBusWidget.tsx"
              }
            }
          ]
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87470ee0-73db-441f-b9b7-9d6350188c63"
      }
    },
    "owner": "willywong",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/87470ee0-73db-441f-b9b7-9d6350188c63"
    }
  }
}
