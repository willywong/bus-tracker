{
  "expo": {
    "name": "BusBuddy",
    "slug": "bus-tracker",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "t816",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.willywong.bustracker",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.willywong.bustracker"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-task-manager",
      "expo-background-fetch",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow BusBuddy to show bus and user location on the map."
        }
      ],
      "expo-web-browser",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.willywong.bustracker.widgets",
          "groupIdentifier": "group.com.willywong.bustracker",
          "enablePushNotifications": false,
          "widgets": []
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87470ee0-73db-441f-b9b7-9d6350188c63"
      }
    },
    "owner": "willywong",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/87470ee0-73db-441f-b9b7-9d6350188c63"
    }
  }
}
