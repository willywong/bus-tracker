# Public base URL for the Hono API. Only EXPO_PUBLIC_* vars are inlined into
# the mobile bundle. Never put secrets here.
EXPO_PUBLIC_API_BASE_URL=https://bus-tracker-api.vercel.app

# For local dev, copy this file to .env.local and override:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Optional: stub the realtime feed with a synthetic bus advancing along the
# T816 polyline. Useful for testing the Tracker/Map/ETA flow outside service
# hours. Set in .env.local and restart Expo. Remove to go back to live data.
# EXPO_PUBLIC_MOCK_REALTIME=1
