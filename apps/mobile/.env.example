# The app reads GTFS static + realtime straight from api.data.gov.my — no
# backend is required. Only set this if you run the optional apps/api server
# for server-sent "leave now" push notifications. Only EXPO_PUBLIC_* vars are
# inlined into the mobile bundle. Never put secrets here.
# EXPO_PUBLIC_API_BASE_URL=https://your-backend.vercel.app

# Optional: stub the realtime feed with a synthetic bus advancing along the
# T816 polyline. Useful for testing the Tracker/Map/ETA flow outside service
# hours. Set in .env.local and restart Expo. Remove to go back to live data.
# EXPO_PUBLIC_MOCK_REALTIME=1

# Optional: offset the app's internal "now" by this many ms. Pairs with
# MOCK_REALTIME to test the Dynamic Island / tracker during off-hours, when
# the real wall clock is outside T816 service (06:13–23:59). 6h = 21600000.
# Unset (or 0) in prod — zero behavior change.
# EXPO_PUBLIC_DEV_NOW_OFFSET_MS=21600000

# Optional: Google Street View Static API key, for a photo of each stop in
# the stop sheet. Without it the sheet only links out to Street View. This
# key ships inside the app, so in Google Cloud restrict it to the Street View
# Static API and set a daily quota cap. Free usage covers ~10k photos/month.
# EXPO_PUBLIC_GOOGLE_MAPS_KEY=
