   public func application(_ application: UIApplication, performActionFor shortcutItem: UIApplicationShortcutItem, completionHandler: @escaping (Bool) -> Void) {
+    // With the scene lifecycle a cold launch never puts the item in
+    // `launchOptions`: it arrives here, before JS listens. Keep it as `initial`.
+    if !quickActionObserving {
+      initialAction = shortcutItem
+    }
     NotificationCenter.default.post(name: Notification.Name(onQuickAction), object: shortcutItem)
     completionHandler(true)
   }
