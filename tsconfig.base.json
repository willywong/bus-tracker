{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@bus-tracker/shared": ["./packages/shared/src/index.ts"],
      "@bus-tracker/shared/*": ["./packages/shared/src/*"]
    }
  }
}
